{
  "expo": {
    "name": "MacroMax",
    "slug": "macromax",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/macromax_A_ring_1024.png",
    "scheme": "macromax",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F9F6",
    "splash": {
      "image": "./assets/macromax_A_ring_1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F9F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.macromax.app"
    },
    "android": {
      "package": "com.macromax.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/macromax_A_ring_1024.png",
        "backgroundColor": "#0B4335"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MacroMax to scan food barcodes."
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#10B981",
          "defaultChannel": "meal-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d5395ddd-a1dd-4937-8e5f-410b55349354"
      }
    }
  }
}

  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/node": "^24.13.4",
    "@types/react": "~19.2.4",
    "csv-parser": "^3.2.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"

# ---------------------------------------------------------------------------
# MacroMax — external food data providers
# ---------------------------------------------------------------------------

# FatSecret Platform API (OAuth 2.0, client credentials) — text search for
# raw ingredients & dishes (method=food.search/foods.search, method=food.get).
# Register an app at https://platform.fatsecret.com and request a Client ID
# and Client Secret. NOTE: production builds must exchange tokens through a
# proxy server (FatSecret locks token requests to registered IPs) — do not
# ship the secret inside a public app binary.
EXPO_PUBLIC_FATSECRET_CLIENT_ID=cc12fe3c9ba2430fa304c1dc3272fd94
EXPO_PUBLIC_FATSECRET_CLIENT_SECRET=9204a21d418a4fec9558874ebb70deea

# Optional FatSecret result region (e.g. "IN" for Indian results; defaults
# to the platform default region).
# EXPO_PUBLIC_FATSECRET_REGION=IN

# Open Food Facts requires a descriptive User-Agent to avoid rate-limiting.
# Customize the contact part before shipping:
# EXPO_PUBLIC_OFF_USER_AGENT=MacroMax/1.0 (contact@example.com)
